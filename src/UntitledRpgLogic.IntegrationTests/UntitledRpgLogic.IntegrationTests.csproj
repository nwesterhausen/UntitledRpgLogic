<Project Sdk="MSTest.Sdk/4.4.0">
	<PropertyGroup>
		<!-- Do not generate or require XML documentation in tests -->
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<!--
			Displays error on console in addition to the log file. Note that this feature comes with a performance impact.
			For more information, visit https://learn.microsoft.com/dotnet/core/testing/unit-testing-platform-integration-dotnet-test#show-failure-per-test
			-->
		<TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
	</PropertyGroup>

	<ItemGroup>
		<!-- EF Core Packages needed to run migrations/contexts in tests -->
		<PackageReference Include="Microsoft.EntityFrameworkCore" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
	</ItemGroup>

	<ItemGroup>
		<!-- Project References to your adapters and domain layers -->
		<ProjectReference Include="..\UntitledRpgLogic.Core\UntitledRpgLogic.Core.csproj" />
		<ProjectReference Include="..\UntitledRpgLogic.Extensions.Common\UntitledRpgLogic.Extensions.Common.csproj" />
		<ProjectReference Include="..\UntitledRpgLogic.Infrastructure.Data\UntitledRpgLogic.Infrastructure.Data.csproj" />
		<ProjectReference Include="..\UntitledRpgLogic.Infrastructure.Data.SQLite\UntitledRpgLogic.Infrastructure.Data.Sqlite.csproj" />
		<ProjectReference Include="..\UntitledRpgLogic.Infrastructure.Data.PostgreSQL\UntitledRpgLogic.Infrastructure.Data.PostgreSQL.csproj" />
	</ItemGroup>
</Project>
